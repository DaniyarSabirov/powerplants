@startuml
note as N1
  publicNames are displayed to other Accounts
  They should be unique

  Names and Content are subject to change
end note

class Account {
  id: UUID
  publicName: String not null
  loginName: String not null
  loginPassword: StringHash not null
  picture: ImageURL
}

class Home {
  id: UUID
  publicName: String not null
  description: String
}

class AccountHome {
  --- FK ---
  account: Account not null
  home: Home not null
}
note left: many-to-many relationship (Account and Home) - PK (accountId and homeId)

class Group {
  id: UUID
  publicName: String not null
  description: String
  picture: ImageURL
  --- FK ---
  home: Home not null
}

class Plant {
  id: UUID
  publicName: String not null
  scientificName: String not null
  description: String
  picture: ImageURL
  metadata: PlantMetadata
  --- FK ---
  group: Group not null
}

class PlantCareDone {
  id: UUID
  completedAt: TimestampTZ not null
  details: String
  --- FK ---
  plant: Plant not null
  rule: PlantCareRule not null
  completedBy: Account not null
}
note left: account has taken care of a plant / history

class PlantCareRule {
  id: UUID
  publicName: String not null
  enabled: boolean not null
  cron: String not null
  instructions: String
  --- FK ---
  plant: Plant not null
}
note right: cron defines the repetition interval

class CustomPlantCareRule {
  instructions: String not null
}

class WaterPlantCareRule {
  amount: Long not null
}

class SunlightPlantCareRule {
  duration: Long not null
}

class PruningPlantCareRule {
  amount: enum LESS, MORE, MUCH not null
}

class PlantCareRuleDisabled {
  --- FK ---
  account: Account
  rule: PlantCareRule
}

Account "1" -- "*" AccountHome
Home "1" -- "*" AccountHome
Home "1" *-- "1..*" Group : has
Group "1" *-- "*" Plant : contains

Plant "1" *-- "*" PlantCareDone : has
Plant "1" *-- "*" PlantCareRule : has

PlantCareRule <|-- CustomPlantCareRule
PlantCareRule <|-- WaterPlantCareRule
PlantCareRule <|-- SunlightPlantCareRule
PlantCareRule <|-- PruningPlantCareRule

Account "1" -- "*" PlantCareRuleDisabled
PlantCareRule "1" -- "*" PlantCareRuleDisabled
@enduml